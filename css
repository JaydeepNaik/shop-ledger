*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:linear-gradient(135deg,#0f9d58,#34d399);
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:20px;
}

.container{
    width:100%;
    display:flex;
    justify-content:center;
    align-items:center;
}

.login-card,
.register-card,
.dashboard-card{

    width:100%;
    max-width:420px;

    background:rgba(255,255,255,.18);

    backdrop-filter:blur(18px);

    border-radius:20px;

    padding:35px;

    box-shadow:0 15px 40px rgba(0,0,0,.25);

    animation:fadeUp .6s ease;

}

h1{
    color:#fff;
    text-align:center;
    margin-bottom:10px;
}

p{
    text-align:center;
    color:#f5f5f5;
    margin-bottom:25px;
}

input{

    width:100%;

    padding:15px;

    margin-bottom:15px;

    border:none;

    border-radius:12px;

    font-size:15px;

    outline:none;

}

input:focus{

    box-shadow:0 0 10px rgba(255,255,255,.6);

}

button{

    width:100%;

    padding:15px;

    background:#ffffff;

    color:#0f9d58;

    border:none;

    border-radius:12px;

    font-size:16px;

    font-weight:600;

    cursor:pointer;

    transition:.3s;

}

button:hover{

    transform:translateY(-3px);

    background:#eafaf0;

}

.divider{

    margin:25px 0;

    height:1px;

    background:rgba(255,255,255,.4);

}

.registerBtn{

    display:block;

    text-align:center;

    text-decoration:none;

    color:white;

    border:2px solid white;

    padding:12px;

    border-radius:12px;

    transition:.3s;

}

.registerBtn:hover{

    background:white;

    color:#0f9d58;

}

@keyframes fadeUp{

    from{

        opacity:0;

        transform:translateY(40px);

    }

    to{

        opacity:1;

        transform:translateY(0);

    }

}

/* Dashboard */

.dashboard{

    width:100%;

    max-width:1100px;

}

.header{

    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:25px;

    color:white;

}

.logout{

    background:red;

    color:white;

    width:120px;

}

.logout:hover{

    background:#d40000;

}

.card-grid{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));

    gap:20px;

}

.expense-card{

    background:white;

    border-radius:15px;

    padding:20px;

    text-align:center;

    box-shadow:0 10px 20px rgba(0,0,0,.15);

    transition:.3s;

}

.expense-card:hover{

    transform:translateY(-8px);

}

.expense-card h2{

    color:#0f9d58;

    margin-bottom:10px;

}

.expense-card p{

    color:#666;

}

.addBtn{

    margin-top:15px;

    background:#0f9d58;

    color:white;

}

.addBtn:hover{

    background:#087f45;

}

.summary{

    margin-top:30px;

    background:white;

    border-radius:20px;

    padding:25px;

    box-shadow:0 10px 20px rgba(0,0,0,.15);

}

.summary h2{

    color:#0f9d58;

    margin-bottom:20px;

}

table{

    width:100%;

    border-collapse:collapse;

}

table th{

    background:#0f9d58;

    color:white;

    padding:12px;

}

table td{

    padding:12px;

    border-bottom:1px solid #ddd;

}

.delete{

    background:red;

    color:white;

    width:80px;

    padding:8px;

}

.total{

    margin-top:20px;

    font-size:22px;

    font-weight:600;

    color:#0f9d58;

}

@media(max-width:768px){

.header{

flex-direction:column;

gap:15px;

}

.login-card{

padding:25px;

}

}